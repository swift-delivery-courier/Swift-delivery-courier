PORT=3000
NODE_ENV=production
BASE_URL=https://your-app.onrender.com

# REQUIRED in production — long random string
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# PostgreSQL (recommended for free cloud hosting)
# Get a free DB from https://neon.tech or Supabase
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# If DATABASE_URL is NOT set, SQLite file is used:
# DATABASE_PATH=./db/swift.db

ADMIN_EMAIL=admin@swiftdeliverycourier.com
ADMIN_PASSWORD=ChangeMeToAStrongPassword
ADMIN_NAME=System Admin

# Optional
# PGSSL=false
